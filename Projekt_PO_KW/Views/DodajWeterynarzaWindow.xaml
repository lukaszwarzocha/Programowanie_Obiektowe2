<Window x:Class="Projekt_PO_KW.Views.DodajWeterynarzaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj weterynarza" Height="830" Width="420" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="White">
        <Border Margin="20">
            <StackPanel Margin="20,15">
                <TextBlock Text="Dodaj weterynarza" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

                <TextBlock Text="Imię" FontWeight="Bold" Margin="0,0,0,5"/>
                <Border CornerRadius="8" BorderBrush="#FFE5E7EB" BorderThickness="1" Background="#FFF9FAFB" Height="32" Margin="0,0,0,12">
                    <TextBox x:Name="PoleImie" BorderThickness="0" Background="Transparent" Padding="8,4"/>
                </Border>

                <TextBlock Text="Nazwisko" FontWeight="Bold" Margin="0,0,0,5"/>
                <Border CornerRadius="8" BorderBrush="#FFE5E7EB" BorderThickness="1" Background="#FFF9FAFB" Height="32" Margin="0,0,0,12">
                    <TextBox x:Name="PoleNazwisko" BorderThickness="0" Background="Transparent" Padding="8,4"/>
                </Border>

                <TextBlock Text="Specjalizacja" FontWeight="Bold" Margin="0,0,0,5"/>
                <Border CornerRadius="8" BorderBrush="#FFE5E7EB" BorderThickness="1" Background="#FFF9FAFB" Height="32" Margin="0,0,0,12">
                    <TextBox x:Name="PoleSpecjalizacja" BorderThickness="0" Background="Transparent" Padding="8,4"/>
                </Border>

                <TextBlock Text="Email" FontWeight="Bold" Margin="0,0,0,5"/>
                <Border CornerRadius="8" BorderBrush="#FFE5E7EB" BorderThickness="1" Background="#FFF9FAFB" Height="32" Margin="0,0,0,12">
                    <TextBox x:Name="PoleEmail" BorderThickness="0" Background="Transparent" Padding="8,4"/>
                </Border>

                <TextBlock Text="Telefon" FontWeight="Bold" Margin="0,0,0,5"/>
                <Border CornerRadius="8" BorderBrush="#FFE5E7EB" BorderThickness="1" Background="#FFF9FAFB" Height="32" Margin="0,0,0,12">
                    <TextBox x:Name="PoleTelefon" BorderThickness="0" Background="Transparent" Padding="8,4"/>
                </Border>

                <TextBlock Text="Hasło" FontWeight="Bold" Margin="0,0,0,5"/>
                <Border CornerRadius="8" BorderBrush="#FFE5E7EB" BorderThickness="1" Background="#FFF9FAFB" Height="32" Margin="0,0,0,20">
                    <PasswordBox x:Name="PoleHaslo" BorderThickness="0" Background="Transparent" Padding="8,4"/>
                </Border>

                <TextBlock Text="Godziny pracy" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                <TextBlock Text="Zostaw puste jeśli lekarz nie pracuje danego dnia"
                           Foreground="#FF9CA3AF" FontSize="11" Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Od" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Do" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Pon" VerticalAlignment="Center" Margin="0,0,10,8"/>
                    <Border Grid.Row="1" Grid.Column="1" CornerRadius="8" BorderBrush="#FFE5E7EB" BorderThickness="1" Background="#FFF9FAFB" Height="30" Margin="0,0,0,8">
                        <TextBox x:Name="PonOd" BorderThickness="0" Background="Transparent" Padding="8,4" Text="08:00"/>
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,4,8"/>
                    <Border Grid.Row="1" Grid.Column="3" CornerRadius="8" BorderBrush="#FFE5E7EB" BorderThickness="1" Background="#FFF9FAFB" Height="30" Margin="0,0,0,8">
                        <TextBox x:Name="PonDo" BorderThickness="0" Background="Transparent" Padding="8,4" Text="15:00"/>
                    </Border>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Wt" VerticalAlignment="Center" Margin="0,0,10,8"/>
                    <Border Grid.Row="2" Grid.Column="1" CornerRadius="8" BorderBrush="#FFE5E7EB" BorderThickness="1" Background="#FFF9FAFB" Height="30" Margin="0,0,0,8">
                        <TextBox x:Name="WtOd" BorderThickness="0" Background="Transparent" Padding="8,4" Text="08:00"/>
                    </Border>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,4,8"/>
                    <Border Grid.Row="2" Grid.Column="3" CornerRadius="8" BorderBrush="#FFE5E7EB" BorderThickness="1" Background="#FFF9FAFB" Height="30" Margin="0,0,0,8">
                        <TextBox x:Name="WtDo" BorderThickness="0" Background="Transparent" Padding="8,4" Text="15:00"/>
                    </Border>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Śr" VerticalAlignment="Center" Margin="0,0,10,8"/>
                    <Border Grid.Row="3" Grid.Column="1" CornerRadius="8" BorderBrush="#FFE5E7EB" BorderThickness="1" Background="#FFF9FAFB" Height="30" Margin="0,0,0,8">
                        <TextBox x:Name="SrOd" BorderThickness="0" Background="Transparent" Padding="8,4" Text="08:00"/>
                    </Border>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,4,8"/>
                    <Border Grid.Row="3" Grid.Column="3" CornerRadius="8" BorderBrush="#FFE5E7EB" BorderThickness="1" Background="#FFF9FAFB" Height="30" Margin="0,0,0,8">
                        <TextBox x:Name="SrDo" BorderThickness="0" Background="Transparent" Padding="8,4" Text="15:00"/>
                    </Border>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Czw" VerticalAlignment="Center" Margin="0,0,10,8"/>
                    <Border Grid.Row="4" Grid.Column="1" CornerRadius="8" BorderBrush="#FFE5E7EB" BorderThickness="1" Background="#FFF9FAFB" Height="30" Margin="0,0,0,8">
                        <TextBox x:Name="CzwOd" BorderThickness="0" Background="Transparent" Padding="8,4" Text="08:00"/>
                    </Border>
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,4,8"/>
                    <Border Grid.Row="4" Grid.Column="3" CornerRadius="8" BorderBrush="#FFE5E7EB" BorderThickness="1" Background="#FFF9FAFB" Height="30" Margin="0,0,0,8">
                        <TextBox x:Name="CzwDo" BorderThickness="0" Background="Transparent" Padding="8,4" Text="15:00"/>
                    </Border>
                    
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Pt" VerticalAlignment="Center" Margin="0,0,10,8"/>
                    <Border Grid.Row="5" Grid.Column="1" CornerRadius="8" BorderBrush="#FFE5E7EB" BorderThickness="1" Background="#FFF9FAFB" Height="30" Margin="0,0,0,8">
                        <TextBox x:Name="PtOd" BorderThickness="0" Background="Transparent" Padding="8,4" Text="08:00"/>
                    </Border>
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,4,8"/>
                    <Border Grid.Row="5" Grid.Column="3" CornerRadius="8" BorderBrush="#FFE5E7EB" BorderThickness="1" Background="#FFF9FAFB" Height="30" Margin="0,0,0,8">
                        <TextBox x:Name="PtDo" BorderThickness="0" Background="Transparent" Padding="8,4" Text="15:00"/>
                    </Border>
                </Grid>

                <Button Content="Dodaj" Height="36" Margin="0,10,0,0" Click="Dodaj_Click"
                        Background="#FFFB7185" Foreground="White" BorderThickness="0" FontWeight="Bold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
